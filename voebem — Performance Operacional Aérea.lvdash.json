{
  "datasets": [
    {
      "name": "762e0db4",
      "displayName": "atrasos_por_aeroporto",
      "queryLines": [
        "-- P1 — Quais rotas e aeroportos concentram os maiores atrasos de partida no Brasil?\n",
        "-- Filtro de período via parâmetros :data_inicio e :data_fim (Global Filters).\r\n",
        "-- Recorte: aeroportos de origem no Brasil, com volume relevante (>= 5.000 voos).\r\n",
        "SELECT\r\n",
        "  nome_aeroporto_origem,\r\n",
        "  municipio_origem,\r\n",
        "  uf_origem,\r\n",
        "  COUNT(*)                                                                   AS voos,\r\n",
        "  ROUND(AVG(atraso_partida_min), 2)                                          AS atraso_medio_min,\r\n",
        "  ROUND(100.0 * try_divide(SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END),\r\n",
        "                           SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), 2) AS pct_atrasados\r\n",
        "FROM voebem.gold.obt_voos\r\n",
        "WHERE pais_origem = 'Brasil'\n",
        "  AND (:data_inicio IS NULL OR partida_prevista_data >= :data_inicio)\n",
        "  AND (:data_fim IS NULL OR partida_prevista_data <= :data_fim)\r\n",
        "GROUP BY 1, 2, 3\r\n",
        "HAVING COUNT(*) >= 5000\r\n",
        "ORDER BY pct_atrasados DESC\r\n",
        "LIMIT 10;"
      ],
      "parameters": [
        {
          "displayName": "Data de início",
          "keyword": "data_inicio",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-08-01"
                }
              ]
            }
          }
        },
        {
          "displayName": "Data de fim",
          "keyword": "data_fim",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-08-01"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "f46c5894",
      "displayName": "atraso_por_hora",
      "queryLines": [
        "-- P2 — como o atraso de partida evolui ao longo do dia?(efeito cascata).\n",
        "-- Filtro de período via parâmetros :data_inicio e :data_fim (Global Filters).\r\n",
        "SELECT\r\n",
        "  hora_partida_prevista AS hora,\r\n",
        "  COUNT(*) AS voos,\r\n",
        "  ROUND(AVG(atraso_partida_min), 2) AS atraso_medio_min,\r\n",
        "  ROUND(\r\n",
        "    100.0 * try_divide(\r\n",
        "        SUM(CASE WHEN partida_pontual = false THEN 1 ELSE 0 END),\r\n",
        "        SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), 2) AS pct_atrasados\r\n",
        "FROM voebem.gold.obt_voos\r\n",
        "WHERE hora_partida_prevista IS NOT NULL\n",
        "  AND (:data_inicio IS NULL OR partida_prevista_data >= :data_inicio)\n",
        "  AND (:data_fim IS NULL OR partida_prevista_data <= :data_fim)\r\n",
        "GROUP BY 1\r\n",
        "ORDER BY 1"
      ],
      "parameters": [
        {
          "displayName": "Data de início",
          "keyword": "data_inicio",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-08-01"
                }
              ]
            }
          }
        },
        {
          "displayName": "Data de fim",
          "keyword": "data_fim",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-08-01"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "71d80f89",
      "displayName": "recuperacao_por_companhia",
      "queryLines": [
        "SELECT\r\n",
        "  nome_companhia,\r\n",
        "  COUNT(*)                                                                   AS voos,\r\n",
        "  ROUND(AVG(atraso_partida_min), 2)                                          AS atraso_saida_min,\r\n",
        "  ROUND(AVG(atraso_chegada_min), 2)                                          AS atraso_chegada_min,\r\n",
        "  ROUND(AVG(minutos_recuperados), 2)                                         AS recuperados_medio_min\r\n",
        "FROM voebem.gold.obt_voos\r\n",
        "WHERE minutos_recuperados IS NOT NULL\n",
        "  AND (:data_inicio IS NULL OR partida_prevista_data >= :data_inicio)\n",
        "  AND (:data_fim IS NULL OR partida_prevista_data <= :data_fim)\n",
        "-- Filtro de companhia aérea via column-based filter (Global Filters)\r\n",
        "GROUP BY 1\r\n",
        "HAVING COUNT(*) >= 10000\r\n",
        "ORDER BY recuperados_medio_min DESC;\r\n"
      ],
      "parameters": [
        {
          "displayName": "Data de início",
          "keyword": "data_inicio",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-08-01"
                }
              ]
            }
          }
        },
        {
          "displayName": "Data de fim",
          "keyword": "data_fim",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-08-01"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "9073238e",
      "displayName": "pontualidade_por_companhia",
      "queryLines": [
        "SELECT\r\n",
        "  nome_companhia,\r\n",
        "  COUNT(*)                                                                   AS voos,\r\n",
        "  ROUND(100.0 * SUM(CASE WHEN voo_cancelado THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_cancelados,\r\n",
        "  ROUND(100.0 * try_divide(SUM(CASE WHEN partida_pontual = true THEN 1 ELSE 0 END),\r\n",
        "                           SUM(CASE WHEN partida_pontual IS NOT NULL THEN 1 ELSE 0 END)), \r\n",
        "2) AS pct_pontuais,\r\n",
        "  ROUND(AVG(atraso_partida_min), 2)                                          AS atraso_medio_min\r\n",
        "FROM voebem.gold.obt_voos\n",
        "WHERE (:data_inicio IS NULL OR partida_prevista_data >= :data_inicio)\n",
        "  AND (:data_fim IS NULL OR partida_prevista_data <= :data_fim)\n",
        "-- Filtro de companhia aérea via column-based filter (Global Filters)\n",
        "GROUP BY 1\r\n",
        "HAVING COUNT(*) >= 10000\r\n",
        "ORDER BY pct_pontuais DESC;\r\n"
      ],
      "parameters": [
        {
          "displayName": "Data de início",
          "keyword": "data_inicio",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2025-08-01"
                }
              ]
            }
          }
        },
        {
          "displayName": "Data de fim",
          "keyword": "data_fim",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-08-01"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "total_voos",
      "displayName": "Total_de_Voos",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_voos\n",
        "FROM\n",
        "  voebem.gold.obt_voos\n",
        "WHERE\n",
        "  pais_origem = 'Brasil'"
      ]
    },
    {
      "name": "pontualidade_geral",
      "displayName": "Pontualidade_Geral",
      "queryLines": [
        "SELECT\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * try_divide(\n",
        "        SUM(\n",
        "          CASE\n",
        "            WHEN partida_pontual = true THEN 1\n",
        "            ELSE 0\n",
        "          END\n",
        "        ),\n",
        "        SUM(\n",
        "          CASE\n",
        "            WHEN partida_pontual IS NOT NULL THEN 1\n",
        "            ELSE 0\n",
        "          END\n",
        "        )\n",
        "      ),\n",
        "    1\n",
        "  ) AS pontualidade_media\n",
        "FROM\n",
        "  voebem.gold.obt_voos\n",
        "WHERE\n",
        "  pais_origem = 'Brasil'"
      ]
    },
    {
      "name": "filter_companhia",
      "displayName": "Filtro_Companhia",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  nome_companhia\n",
        "FROM\n",
        "  voebem.gold.obt_voos\n",
        "WHERE\n",
        "  nome_companhia IS NOT NULL\n",
        "ORDER BY\n",
        "  nome_companhia"
      ]
    },
    {
      "name": "filter_periodo",
      "displayName": "Filtro Período",
      "queryLines": [
        "SELECT\n",
        "  MIN(partida_prevista_data) AS partida_prevista_data\n",
        "FROM\n",
        "  voebem.gold.obt_voos\n",
        "WHERE\n",
        "  pais_origem = 'Brasil'\n",
        "UNION ALL\n",
        "SELECT\n",
        "  MAX(partida_prevista_data) AS partida_prevista_data\n",
        "FROM\n",
        "  voebem.gold.obt_voos\n",
        "WHERE\n",
        "  pais_origem = 'Brasil'"
      ]
    }
  ],
